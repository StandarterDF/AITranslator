# Здесь только API-ключи.
# Имя переменной может быть любым — на него ссылается поле api_key в config.json / шаблонах.

# Local LLM (OpenAI-compatible, e.g. LM Studio, Ollama, vLLM)
LOCALLLM_API_KEY=sk-LocalHost

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# LibreTranslate (необязательно)
LIBRETRANSLATE_API_KEY=
