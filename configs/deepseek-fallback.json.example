{
  "_comment": "DeepSeek + Google/LibreTranslate fallback. Скопируй в config.json в корне проекта.",
  "providers": {
    "deepseek": {
      "api_key": "DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-v4-flash",
      "prefill": "",
      "api_type": "deepseek",
      "reasoning_effort": null
    }
  },
  "default_provider": "deepseek",
  "translation_chain": [
    {"type": "llm", "provider": "deepseek", "max_tokens": null},
    {"type": "google"}
  ],
  "log_level": "INFO"
}
